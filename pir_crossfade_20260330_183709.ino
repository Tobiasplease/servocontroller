// ==================== HELPER FUNCTIONS ====================

int applyServoLimits(int angle, int servoIdx) {
  // Map 0-180 stored value to MIN_ANGLE-MAX_ANGLE output (matches listener behavior)
  int pos = map(angle, 0, 180, MIN_ANGLE, MAX_ANGLE);
  pos = constrain(pos, MIN_ANGLE, MAX_ANGLE);
  
  // Apply reversal WITHIN the output range (matches listener: MAX_ANGLE - pos)
  if (servoReversed[servoIdx]) {
    pos = MAX_ANGLE - pos;
  }
  return pos;
}

int blendPositions(int from, int to, float factor) {
  // Smootherstep for very smooth state transitions (barely noticeable)
  float t = factor;
  float easedFactor = t * t * t * (t * (t * 6.0 - 15.0) + 10.0);  // Ken Perlin smootherstep
  return from + (int)((to - from) * easedFactor);
}

void getPositionsForRecording(State state, int slot, unsigned long playbackTime, int* positions) {
  unsigned long duration;
  int numSamples;
  int sampleIdx, nextIdx;
  unsigned long samplePos;
  int fraction;
  int recIdx;
  
  // Get the recording index for this slot
  switch (state) {
    case STATE_IDLE:   recIdx = (slot == 0) ? idleRecA : idleRecB; break;
    case STATE_ACTIVE: recIdx = (slot == 0) ? activeRecA : activeRecB; break;
    case STATE_SLEEP:  recIdx = (slot == 0) ? sleepRecA : sleepRecB; break;
    default: recIdx = 0; break;
  }
  
  // Now get positions from the selected recording
  switch (state) {
    case STATE_IDLE:
      switch (recIdx) {
        case 0:
          duration = idle_0Duration;
          numSamples = idle_0NumSamples;
          if (duration > 0) playbackTime = playbackTime % duration;
          samplePos = ((unsigned long)playbackTime * numSamples * 1000UL) / duration;
          sampleIdx = samplePos / 1000;
          if (sampleIdx >= numSamples) sampleIdx = numSamples - 1;
          nextIdx = (sampleIdx + 1) % numSamples;
          fraction = samplePos % 1000;
          for (int i = 0; i < NUM_SERVOS; i++) {
            int curr = pgm_read_byte(&idle_0Data[sampleIdx][i]);
            int next = pgm_read_byte(&idle_0Data[nextIdx][i]);
            positions[i] = curr + ((next - curr) * fraction) / 1000;
